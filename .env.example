# ==============================================================================
# JNPHS Official Website - Backend SMTP Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in the project root: copy .env.example .env
# 2. Fill in your official Gmail SMTP credentials or other SMTP provider details.
# 3. For Gmail accounts:
#    - Enable 2-Step Verification in your Google Account security settings.
#    - Generate a 16-character "App Password" (choose Mail / Other name).
#    - Set SMTP_USER to your Gmail address and SMTP_PASS to the App Password.
# 4. Run the server using: python server.py
#
# IMPORTANT:
# - DO NOT commit your real .env file or passwords to version control.
# - The backend reads these variables from .env or your server environment.
# ==============================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=jnphschool@gmail.com
SMTP_PASS=your_gmail_app_password_here
RECIPIENT_EMAIL=jnphschool@gmail.com
PORT=5500
